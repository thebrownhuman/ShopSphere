// Platform tables for M0. Module tables (identity, catalog, ...) are added per milestone.
// Conventions: money = BigInt paise, timestamps = timestamptz (UTC), snake_case in SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Transactional outbox: written in the same tx as the domain change, relayed by OutboxPublisher.
model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([createdAt], map: "idx_outbox_events_unpublished")
  @@map("outbox_events")
}

/// Append-only audit trail for privileged / money-moving actions.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id")
  actorType  String   @map("actor_type")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@map("audit_logs")
}

/// Idempotent consumer ledger (M0.15): one row per (consumer, event) ever handled.
model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@map("processed_events")
}

// ───────────────────────── Identity (M1) ─────────────────────────

/// Customer account. Login identifiers live in user_identities.
model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String?
  passwordHash    String?   @map("password_hash")
  totpSecret      String?   @map("totp_secret")
  totpEnabled     Boolean   @default(false) @map("totp_enabled")
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  identities    UserIdentity[]
  sessions      Session[]
  addresses     Address[]
  knownDevices  KnownDevice[]

  @@map("users")
}

/// One login identifier per row: type = email | phone | google. value is normalised (lowercased email, E.164 phone, google sub).
model UserIdentity {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String
  value      String
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, value], map: "uq_user_identities_type_value")
  @@index([userId], map: "idx_user_identities_user_id")
  @@map("user_identities")
}

/// A login session = one refresh-token family. Revoking it kills every token in the family.
model Session {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  persistent  Boolean   @default(false)
  userAgent   String?   @map("user_agent")
  ip          String?
  deviceId    String?   @map("device_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt  DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String? @map("revoked_reason")
  /// Last step-up re-auth (password/OTP/TOTP) for sensitive changes.
  reauthAt    DateTime? @map("reauth_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId], map: "idx_sessions_user_id")
  @@map("sessions")
}

/// Rotating refresh tokens. Only the SHA-256 of the token is stored.
model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  tokenHash  String    @unique(map: "uq_refresh_tokens_token_hash") @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "idx_refresh_tokens_session_id")
  @@map("refresh_tokens")
}

/// Audit trail of OTP challenges. Live code/attempt state is in Redis (5-min TTL).
model OtpChallenge {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel     String
  target      String
  purpose     String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(6)
  attempts    Int       @default(0)

  @@index([target, createdAt], map: "idx_otp_challenges_target")
  @@map("otp_challenges")
}

/// Devices that have logged in before; unknown device → new-device alert.
model KnownDevice {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  deviceId    String   @map("device_id")
  userAgent   String?  @map("user_agent")
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId], map: "uq_known_devices_user_device")
  @@map("known_devices")
}

model Address {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String
  phone       String
  line1       String
  line2       String?
  landmark    String?
  city        String
  state       String
  pincode     String
  type        String    @default("home")
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_addresses_user_id")
  @@map("addresses")
}

/// Pincode directory for city/state autofill and serviceability.
model Pincode {
  pincode     String  @id
  city        String
  state       String
  serviceable Boolean @default(true)

  @@map("pincodes")
}

// ---------------------------------------------------------------------------
// Payments (M4.10-M4.18). Owned by src/modules/payment. Status columns are TEXT;
// allowed values live in payment/domain/payment.types.ts.
// ---------------------------------------------------------------------------

/// One gateway order per initiate call. A shop order may have several (retry with another method).
model Payment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String   @map("order_id")
  provider        String
  providerOrderId String   @map("provider_order_id")
  amount          BigInt
  currency        String   @default("INR")
  status          String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  attempts PaymentAttempt[]

  @@unique([provider, providerOrderId], map: "uq_payments_provider_order")
  @@index([orderId], map: "idx_payments_order_id")
  @@index([status, createdAt], map: "idx_payments_status_created")
  @@map("payments")
}

/// One row per gateway payment id seen for a payment (redirect, webhook or reconciliation).
model PaymentAttempt {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId         String   @map("payment_id") @db.Uuid
  orderId           String   @map("order_id")
  provider          String
  providerPaymentId String   @map("provider_payment_id")
  amount            BigInt
  currency          String
  method            String?
  status            String
  errorReason       String?  @map("error_reason")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment Payment  @relation(fields: [paymentId], references: [id])
  refunds Refund[]

  @@unique([provider, providerPaymentId], map: "uq_payment_attempts_provider_payment")
  @@index([orderId], map: "idx_payment_attempts_order_id")
  @@map("payment_attempts")
}

/// First-capture-wins lock: at most one winning captured attempt per shop order.
model OrderPaymentCapture {
  orderId   String   @id @map("order_id")
  attemptId String   @map("attempt_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("order_payment_captures")
}

/// Verified gateway webhooks, stored once per (provider, event id) for idempotent processing.
model WebhookEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  eventType   String    @map("event_type")
  payload     Json
  outcome     String?
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@unique([provider, eventId], map: "uq_webhook_events_provider_event")
  @@map("webhook_events")
}

model Refund {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId        String   @map("attempt_id") @db.Uuid
  orderId          String   @map("order_id")
  provider         String
  providerRefundId String?  @unique(map: "uq_refunds_provider_refund") @map("provider_refund_id")
  amount           BigInt
  reason           String
  status           String
  lastError        String?  @map("last_error")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  attempt PaymentAttempt @relation(fields: [attemptId], references: [id])

  @@index([status], map: "idx_refunds_status")
  @@index([orderId], map: "idx_refunds_order_id")
  @@map("refunds")
}

// ───────── Catalog (M2) ─────────

/// Category tree. `path` is the materialized slug path ("electronics/audio/headphones").
model Category {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId   String?               @map("parent_id") @db.Uuid
  slug       String                @unique
  name       String
  path       String                @unique
  depth      Int                   @default(0)
  position   Int                   @default(0)
  /// GST rate in basis points (1800 = 18%). Null inherits from the parent.
  gstRateBp  Int?                  @map("gst_rate_bp")
  image      String?
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  parent     Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[]            @relation("CategoryTree")
  products   Product[]
  attributes AttributeDefinition[]

  @@index([parentId])
  @@map("categories")
}

/// Per-category attribute schema: drives variant selectors and search facets.
model AttributeDefinition {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  key        String
  label      String
  /// TEXT | NUMBER | COLOR
  type       String   @default("TEXT")
  isVariant  Boolean  @default(false) @map("is_variant")
  filterable Boolean  @default(false)
  position   Int      @default(0)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
  @@map("attribute_definitions")
}

model Brand {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug     String    @unique
  name     String
  products Product[]

  @@map("brands")
}

/// Parent product; purchasable variants are `skus`.
model Product {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String         @unique
  title           String
  brandId         String         @map("brand_id") @db.Uuid
  categoryId      String         @map("category_id") @db.Uuid
  description     String         @default("")
  bullets         Json           @default("[]")
  /// [{ group, items: [{ label, value }] }]
  specs           Json           @default("[]")
  /// Rating x10 (43 = 4.3), integral.
  ratingX10       Int            @default(0) @map("rating_x10")
  ratingCount     Int            @default(0) @map("rating_count")
  /// Lower sells better. Feeds search ranking and best-seller rows.
  salesRank       Int            @default(1000000) @map("sales_rank")
  boughtLastMonth Int            @default(0) @map("bought_last_month")
  returnDays      Int            @default(7) @map("return_days")
  /// ACTIVE | DRAFT | BLOCKED
  status          String         @default("ACTIVE")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  brand           Brand          @relation(fields: [brandId], references: [id])
  category        Category       @relation(fields: [categoryId], references: [id])
  skus            Sku[]
  images          ProductImage[]

  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model Sku {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String         @map("product_id") @db.Uuid
  code       String         @unique
  /// Variant attributes, e.g. {"color":"Black","storage":"128 GB"}
  attributes Json           @default("{}")
  barcode    String?        @unique
  isDefault  Boolean        @default(false) @map("is_default")
  position   Int            @default(0)
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  offers     Offer[]
  images     ProductImage[]

  @@index([productId])
  @@map("skus")
}

/// `storageKey` points at processed renditions in S3 (M2.3 pipeline); `sourceUrl` serves
/// generated placeholder seed images (M2.24).
model ProductImage {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  skuId      String? @map("sku_id") @db.Uuid
  position   Int     @default(0)
  alt        String
  storageKey String? @map("storage_key")
  sourceUrl  String? @map("source_url")
  /// PENDING | READY | FAILED
  status     String  @default("READY")
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        Sku?    @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

/// Seller stub (M2.2). ShopSphere's own warehouses are sellers with is_first_party = true.
model Seller {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String  @unique
  /// Rating x10.
  ratingX10    Int     @default(40) @map("rating_x10")
  isFirstParty Boolean @default(false) @map("is_first_party")
  pincode      String
  city         String
  state        String
  /// Dispatch cutoff hour in IST (0-23); later orders ship the next day.
  cutoffHour   Int     @default(14) @map("cutoff_hour")
  status       String  @default("ACTIVE")
  offers       Offer[]
  account      SellerAccount?

  @@map("sellers")
}

/// SKU x seller. Check constraint stock_qty >= reserved_qty >= 0 lives in the migration SQL.
model Offer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skuId       String   @map("sku_id") @db.Uuid
  sellerId    String   @map("seller_id") @db.Uuid
  price       BigInt
  mrp         BigInt
  stockQty    Int      @default(0) @map("stock_qty")
  reservedQty Int      @default(0) @map("reserved_qty")
  maxPerOrder Int      @default(5) @map("max_per_order")
  /// SHOPSPHERE | SELLER
  fulfilment  String   @default("SELLER")
  /// ACTIVE | INACTIVE
  status      String   @default("ACTIVE")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  sku         Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  seller      Seller   @relation(fields: [sellerId], references: [id])

  @@unique([skuId, sellerId])
  @@index([sellerId])
  @@map("offers")
}

/// Home page CMS rows (M2.15). `dataSource` is type-specific JSON.
model HomeSection {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// HERO_CAROUSEL | QUAD_CARDS | DEAL_ROW | PRODUCT_CAROUSEL | RECENTLY_VIEWED | CATEGORY_TILES
  type       String
  title      String
  dataSource Json      @default("{}") @map("data_source")
  position   Int
  /// ALL | GUEST | SIGNED_IN
  audience   String    @default("ALL")
  active     Boolean   @default(true)
  startsAt   DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime? @map("ends_at") @db.Timestamptz(6)

  @@index([position])
  @@map("home_sections")
}

/// Last viewed products per owner ("u:<userId>" or "g:<guestId>"), trimmed to 20 (M2.21).
model RecentlyViewed {
  ownerKey  String   @map("owner_key")
  productId String   @map("product_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)

  @@id([ownerKey, productId])
  @@index([ownerKey, viewedAt])
  @@map("recently_viewed")
}

/// Co-view counts for "customers also viewed" (v1: pairs within one owner's recent views).
model CoView {
  productId String @map("product_id") @db.Uuid
  otherId   String @map("other_id") @db.Uuid
  count     Int    @default(0)

  @@id([productId, otherId])
  @@index([productId, count])
  @@map("co_views")
}

/// Search analytics (M2.12): one row per query and per result click.
model SearchEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// QUERY | CLICK
  type         String
  searchId     String   @map("search_id")
  query        String
  normalized   String
  resultsCount Int?     @map("results_count")
  productId    String?  @map("product_id")
  position     Int?
  ownerKey     String?  @map("owner_key")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([normalized, createdAt])
  @@index([searchId])
  @@map("search_events")
}

// ---------------------------------------------------------------------------
// Cart and wishlist (M3). Owned by src/modules/cart. SKU/offer/seller ids are plain columns
// (no FK into catalog tables) so the cart survives catalog edits and reports them as changes.
// ---------------------------------------------------------------------------

/// One ACTIVE cart per user (partial unique index in SQL) or per guest token.
model Cart {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  /// Random token carried in the signed guest_cart cookie.
  guestToken String?   @unique @map("guest_token")
  /// ACTIVE | MERGED | CHECKED_OUT
  status     String    @default("ACTIVE")
  version    Int       @default(0)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  items      CartItem[]
  saved      SavedItem[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId        String   @map("cart_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  skuId         String   @map("sku_id") @db.Uuid
  sellerId      String   @map("seller_id") @db.Uuid
  offerId       String   @map("offer_id") @db.Uuid
  qty           Int
  /// Unit price (paise) when added; drives price-change banners.
  priceSnapshot BigInt   @map("price_snapshot")
  addedAt       DateTime @default(now()) @map("added_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, skuId, sellerId])
  @@map("cart_items")
}

model SavedItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId        String   @map("cart_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  skuId         String   @map("sku_id") @db.Uuid
  sellerId      String   @map("seller_id") @db.Uuid
  priceSnapshot BigInt   @map("price_snapshot")
  savedAt       DateTime @default(now()) @map("saved_at") @db.Timestamptz(6)
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, skuId, sellerId])
  @@map("saved_items")
}

model Wishlist {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @unique @map("user_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  items     WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wishlistId String   @map("wishlist_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  skuId      String   @map("sku_id") @db.Uuid
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz(6)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, skuId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Checkout, orders, inventory, coupons, ledger (M4). Owned by src/modules/{checkout,order,
// inventory,coupon,ledger}. Status columns are TEXT; allowed values live in the modules.
// Catalog/user ids are plain columns (snapshots survive catalog edits).
// ---------------------------------------------------------------------------

/// 30-minute checkout (cart snapshot or Buy Now item) the shopper edits before placing.
model CheckoutSession {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  /// CART | BUY_NOW
  source          String
  cartId          String?  @map("cart_id") @db.Uuid
  /// [{skuId, sellerId, qty, priceSnapshot}]
  items           Json
  addressId       String?  @map("address_id") @db.Uuid
  /// [{shipmentKey, type, slotDate?}]
  deliveryChoices Json     @default("[]") @map("delivery_choices")
  /// {type: ONLINE, provider} | {type: COD} | null
  paymentMethod   Json?    @map("payment_method")
  couponCode      String?  @map("coupon_code")
  useStoreBalance Boolean  @default(false) @map("use_store_balance")
  /// Total the shopper was last shown.
  quotedTotal     BigInt?  @map("quoted_total")
  /// OPEN | PLACED | EXPIRED
  status          String   @default("OPEN")
  orderId         String?  @unique @map("order_id") @db.Uuid
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("checkout_sessions")
}

model Order {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number              String    @unique
  userId              String    @map("user_id") @db.Uuid
  checkoutId          String    @unique @map("checkout_id") @db.Uuid
  idempotencyKey      String    @map("idempotency_key")
  status              String
  /// ONLINE | COD | STORE_BALANCE
  paymentMethod       String    @map("payment_method")
  /// Preferred gateway for ONLINE (razorpay | bank).
  paymentProvider     String?   @map("payment_provider")
  itemsPaise          BigInt    @map("items_paise")
  mrpPaise            BigInt    @map("mrp_paise")
  deliveryPaise       BigInt    @map("delivery_paise")
  couponDiscountPaise BigInt    @map("coupon_discount_paise")
  codFeePaise         BigInt    @map("cod_fee_paise")
  totalPaise          BigInt    @map("total_paise")
  storeBalancePaise   BigInt    @map("store_balance_paise")
  payablePaise        BigInt    @map("payable_paise")
  cgstPaise           BigInt    @map("cgst_paise")
  sgstPaise           BigInt    @map("sgst_paise")
  igstPaise           BigInt    @map("igst_paise")
  couponId            String?   @map("coupon_id") @db.Uuid
  couponCode          String?   @map("coupon_code")
  /// Address snapshot (CheckoutAddress).
  address             Json
  shipToState         String    @map("ship_to_state")
  source              String
  cartId              String?   @map("cart_id") @db.Uuid
  /// Online payment deadline; reservations expire with it (15 min, 30 while a payment is pending).
  payBy               DateTime? @map("pay_by") @db.Timestamptz(6)
  cancelReason        String?   @map("cancel_reason")
  placedAt            DateTime  @default(now()) @map("placed_at") @db.Timestamptz(6)
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  shipments    Shipment[]
  items        OrderItem[]
  events       OrderEventRow[]
  reservations InventoryReservation[]

  @@unique([userId, idempotencyKey], map: "uq_orders_user_idempotency")
  @@index([userId, placedAt], map: "idx_orders_user_placed")
  @@index([status, payBy], map: "idx_orders_status_pay_by")
  @@map("orders")
}

/// One package per seller/warehouse (M4.5).
model Shipment {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String      @map("order_id") @db.Uuid
  sellerId              String      @map("seller_id") @db.Uuid
  sellerName            String      @map("seller_name")
  sellerState           String      @map("seller_state")
  fulfilledByShopSphere Boolean     @map("fulfilled_by_shopsphere")
  deliveryOption        String      @map("delivery_option")
  deliveryFeePaise      BigInt      @map("delivery_fee_paise")
  promisedDate          String      @map("promised_date")
  status                String      @default("PENDING")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  order                 Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items                 OrderItem[]

  @@index([orderId])
  @@index([sellerId])
  @@map("shipments")
}

model OrderItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  shipmentId     String   @map("shipment_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  skuId          String   @map("sku_id") @db.Uuid
  offerId        String   @map("offer_id") @db.Uuid
  sellerId       String   @map("seller_id") @db.Uuid
  slug           String
  title          String
  variant        String?
  imageUrl       String?  @map("image_url")
  qty            Int
  unitPricePaise BigInt   @map("unit_price_paise")
  mrpPaise       BigInt   @map("mrp_paise")
  lineTotalPaise BigInt   @map("line_total_paise")
  discountPaise  BigInt   @map("discount_paise")
  gstRateBp      Int      @map("gst_rate_bp")
  taxablePaise   BigInt   @map("taxable_paise")
  cgstPaise      BigInt   @map("cgst_paise")
  sgstPaise      BigInt   @map("sgst_paise")
  igstPaise      BigInt   @map("igst_paise")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([skuId])
  @@map("order_items")
}

/// Order status history (M4.27); drives the tracking timeline.
model OrderEventRow {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  type       String
  note       String?
  actor      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

/// Soft stock hold (M4.1): offers.reserved_qty is incremented atomically while ACTIVE.
model InventoryReservation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  offerId   String   @map("offer_id") @db.Uuid
  skuId     String   @map("sku_id") @db.Uuid
  qty       Int
  /// ACTIVE | CONSUMED | RELEASED
  status    String   @default("ACTIVE")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, expiresAt], map: "idx_inventory_reservations_active")
  @@map("inventory_reservations")
}

/// Coupon engine v1 (M4.6). value = paise (FLAT) or basis points (PERCENT).
model Coupon {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String   @unique
  description      String   @default("")
  /// FLAT | PERCENT
  type             String
  value            BigInt
  minOrderPaise    BigInt   @default(0) @map("min_order_paise")
  maxDiscountPaise BigInt?  @map("max_discount_paise")
  perUserLimit     Int      @default(1) @map("per_user_limit")
  totalLimit       Int?     @map("total_limit")
  usedCount        Int      @default(0) @map("used_count")
  /// Empty = all categories (matches any ancestor category).
  categoryIds      String[] @default([]) @map("category_ids")
  sellerIds        String[] @default([]) @map("seller_ids")
  startsAt         DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime @map("ends_at") @db.Timestamptz(6)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("coupons")
}

/// HELD at place-order, USED on confirm, RELEASED on cancel / payment expiry.
model CouponRedemption {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId    String   @map("coupon_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  orderId     String   @unique @map("order_id") @db.Uuid
  amountPaise BigInt   @map("amount_paise")
  status      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

/// Closed-loop ledger accounts (M4.7). USER accounts can't go negative (CHECK in SQL).
model LedgerAccount {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// USER | SYSTEM
  ownerType    String        @map("owner_type")
  ownerId      String        @map("owner_id")
  /// STORE_BALANCE | GIFT_CARD_FLOAT | ORDER_CLEARING
  kind         String
  balancePaise BigInt        @default(0) @map("balance_paise")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  entries      LedgerEntry[]

  @@unique([ownerType, ownerId, kind], map: "uq_ledger_accounts_owner_kind")
  @@map("ledger_accounts")
}

/// One balanced posting group; `key` makes each business event post at most once.
model LedgerTransaction {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String        @unique
  kind      String
  reference String?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  entries   LedgerEntry[]

  @@map("ledger_transactions")
}

/// Double entry: entries of one transaction sum to zero. Positive = credit to the account.
model LedgerEntry {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String            @map("transaction_id") @db.Uuid
  accountId     String            @map("account_id") @db.Uuid
  amountPaise   BigInt            @map("amount_paise")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  account       LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

/// Closed-loop gift cards: redeemed into the user's store balance; no cash-out or transfer.
model GiftCard {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// sha256 of the normalised code; the code itself is never stored.
  codeHash    String    @unique @map("code_hash")
  last4       String
  amountPaise BigInt    @map("amount_paise")
  /// ACTIVE | REDEEMED | VOID
  status      String    @default("ACTIVE")
  redeemedBy  String?   @map("redeemed_by") @db.Uuid
  redeemedAt  DateTime? @map("redeemed_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("gift_cards")
}

// ───────── Seller Central (M5) ─────────

/// Seller onboarding + KYC (M5.1). A seller is a user with one of these; `sellerId` is set on
/// approval (first-party house accounts have no user). Bank account number is stored only as
/// last 4 + SHA-256 (simulation, never the full number).
model SellerAccount {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?   @unique @map("user_id") @db.Uuid
  sellerId         String?   @unique @map("seller_id") @db.Uuid
  displayName      String    @map("display_name")
  legalName        String?   @map("legal_name")
  /// DRAFT | SUBMITTED | APPROVED | REJECTED
  status           String    @default("DRAFT")
  isFirstParty     Boolean   @default(false) @map("is_first_party")
  pan              String?
  gstin            String?
  bankHolderName   String?   @map("bank_holder_name")
  bankAccountLast4 String?   @map("bank_account_last4")
  bankAccountHash  String?   @map("bank_account_hash")
  bankIfsc         String?   @map("bank_ifsc")
  bankNameAtBank   String?   @map("bank_name_at_bank")
  bankVerifyRef    String?   @map("bank_verify_ref")
  bankVerifiedAt   DateTime? @map("bank_verified_at") @db.Timestamptz(6)
  /// PickupAddress JSON.
  pickup           Json?
  rejectionReason  String?   @map("rejection_reason")
  submittedAt      DateTime? @map("submitted_at") @db.Timestamptz(6)
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  seller           Seller?   @relation(fields: [sellerId], references: [id])
  media            SellerMedia[]

  @@index([status, submittedAt])
  @@map("seller_accounts")
}

/// Listing images uploaded from Seller Central (M5.2), served at GET /seller/media/:id.
model SellerMedia {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerAccountId String        @map("seller_account_id") @db.Uuid
  fileName        String        @map("file_name")
  contentType     String        @map("content_type")
  bytes           Bytes
  sizeBytes       Int           @map("size_bytes")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  account         SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@index([sellerAccountId])
  @@map("seller_media")
}
