NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://shopsphere:shopsphere@localhost:5432/shopsphere?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
OUTBOX_PUBLISHER_ENABLED=false
# Identity (M1)
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
# Must match apps/web SESSION_COOKIE_SECRET (SSR reads the signed ss_session cookie)
SESSION_COOKIE_SECRET=dev-only-session-cookie-secret-0123456789
COOKIE_SECURE=false
SMTP_HOST=localhost
SMTP_PORT=1025
# Leave empty to keep "Continue with Google" disabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloudflare Turnstile test secret (always passes)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Payments (see apps/api/src/modules/payment/payment.config.ts). Bank defaults match apps/bank-sim.
BANK_API_URL=http://localhost:4100/v1
BANK_CHECKOUT_URL=http://localhost:4100/checkout
BANK_KEY_ID=ssb_test_key_id
BANK_KEY_SECRET=ssb_test_key_secret
BANK_WEBHOOK_SECRET=ssb_test_webhook_secret
PAYMENT_INTERNAL_TOKEN=dev-internal-token-change-me
# Razorpay test mode: leave blank to disable. Keys must start with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# M4.36 forced payment outcomes for QA; ignored when NODE_ENV=production
PAYMENT_TEST_TOGGLE=true

# Checkout / orders (M4): in-process expiry sweep + payment event consumer
ORDER_WORKERS_ENABLED=true

# Catalog + search (M2, see apps/api/src/modules/catalog/catalog.config.ts)
OPENSEARCH_URL=http://localhost:9200
SEARCH_INDEX=products
MEDIA_BASE_URL=http://localhost:8333/catalog
CATALOG_INTERNAL_TOKEN=dev-internal-token-change-me

# Fulfilment (M5): courier adapter (shipping.config.ts) and settlement (settlement.config.ts)
COURIER_PROVIDER=courier-sim
COURIER_API_URL=http://localhost:4500/v1
COURIER_API_KEY=cs_test_api_key
COURIER_WEBHOOK_SECRET=cs_test_webhook_secret
SETTLEMENT_COMMISSION_BP=1000
SETTLEMENT_TCS_BP=100
SETTLEMENT_TDS_BP=10
SETTLEMENT_PAYOUT_DELAY_DAYS=7

# Web push (M6.9). Generate with `npx web-push generate-vapid-keys`; unset = push disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@shopsphere.test
# Admin console (M6.5): seeded SUPER_ADMIN (prisma/seed-admin.ts). Local simulation only.
ADMIN_SEED_EMAIL=admin@shopsphere.test
ADMIN_SEED_PASSWORD=Admin@ShopSphere1
