NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://shopsphere:shopsphere@localhost:5432/shopsphere?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
OUTBOX_PUBLISHER_ENABLED=false

# Payments (see apps/api/src/modules/payment/payment.config.ts). Bank defaults match apps/bank-sim.
BANK_API_URL=http://localhost:4100/v1
BANK_CHECKOUT_URL=http://localhost:4100/checkout
BANK_KEY_ID=ssb_test_key_id
BANK_KEY_SECRET=ssb_test_key_secret
BANK_WEBHOOK_SECRET=ssb_test_webhook_secret
PAYMENT_INTERNAL_TOKEN=dev-internal-token-change-me
# Razorpay test mode: leave blank to disable. Keys must start with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
