{
  "name": "@shopsphere/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/main.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "prisma generate && jest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:int": "prisma generate && jest --testPathPattern \"\\.int\\.spec\\.ts$\" --testPathIgnorePatterns \"/node_modules/\"",
    "k6:setup": "ts-node --transpile-only scripts/k6-oversell.ts setup",
    "k6:verify": "ts-node --transpile-only scripts/k6-oversell.ts verify",
    "k6:journey": "ts-node --transpile-only scripts/k6-journey.ts setup"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/s3-request-presigner": "3.700.0",
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "5.22.0",
    "@shopsphere/types": "workspace:*",
    "body-parser": "1.20.3",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "10.3.1",
    "otplib": "12.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "web-push": "3.6.7",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.15",
    "@shopsphere/config": "workspace:*",
    "@types/body-parser": "1.19.6",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.2",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "6.0.2",
    "@types/web-push": "3.6.4",
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.int\\.spec\\.ts$"
    ]
  }
}
