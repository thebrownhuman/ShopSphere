PORT=4100
# Merchant credentials ShopSphere uses (must match BANK_* in apps/api/.env).
MERCHANT_KEY_ID=ssb_test_key_id
MERCHANT_KEY_SECRET=ssb_test_key_secret
WEBHOOK_SECRET=ssb_test_webhook_secret
WEBHOOK_URL=http://localhost:4000/payments/webhooks/bank
ALLOWED_CALLBACK_ORIGINS=http://localhost:3000
LATE_CAPTURE_DELAY_MS=20000
